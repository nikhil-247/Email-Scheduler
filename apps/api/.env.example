# Copy this file to .env and fill in OAuth / SMTP credentials.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
DATABASE_URL=postgresql://scheduler:scheduler_dev_password@localhost:5432/email_scheduler?schema=public
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/api/integrations/slack/callback
SMTP_SENDERS_JSON=[]
DEFAULT_SENDER_KEY=ethereal-primary
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
RATE_LIMIT_RETRY_JITTER_MS=250
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=replace-this-password
